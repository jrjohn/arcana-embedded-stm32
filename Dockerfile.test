FROM gcc:16

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake ninja-build git lcov ca-certificates python3 python3-pip \
    && pip3 install lcov_cobertura --break-system-packages \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . .

# Configure & build
RUN cmake -S Tests -B Tests/build -G Ninja -DCMAKE_BUILD_TYPE=Debug

RUN cmake --build Tests/build -- -j$(nproc)

# Run tests. The exit code is recorded, not swallowed: coverage is still generated below,
# then the last RUN fails the image build (and the Jenkins stage) if any test failed.
# (Previously `|| true` — a failing host test produced a green build.)
RUN cd Tests/build && { ctest --output-on-failure; echo $? > /workspace/ctest.rc; }

# Generate lcov → filter → convert to Cobertura XML
RUN lcov --capture \
      --directory Tests/build \
      --output-file /workspace/coverage.info \
      --rc lcov_branch_coverage=0 --ignore-errors gcov,source,inconsistent && \
    lcov --remove /workspace/coverage.info \
      '*googletest*' '/usr/*' '*/Tests/mocks/*' '*/Tests/test_*' \
      --output-file /workspace/coverage.info && \
    lcov --summary /workspace/coverage.info && \
    # Convert lcov → Cobertura XML (required by sonar-cxx 2.x)
    python3 -m lcov_cobertura /workspace/coverage.info \
      --base-dir /workspace \
      --output /workspace/coverage.xml && \
    # Fix: replace <source>/workspace</source> → <source>.</source>
    # sonar-scanner mounts project at /usr/src, not /workspace
    sed -i 's|<source>/workspace</source>|<source>.</source>|g' /workspace/coverage.xml && \
    echo "coverage.xml generated:" && wc -l /workspace/coverage.xml

# Gate: fail the build when ctest failed (after coverage, so the report still exists).
RUN rc="$(cat /workspace/ctest.rc)"; if [ "$rc" != 0 ]; then echo "host tests FAILED (ctest rc=$rc)"; exit 1; fi; echo "host tests: PASS"

CMD ["echo", "Tests complete. Artifacts: /workspace/coverage.info /workspace/coverage.xml"]
